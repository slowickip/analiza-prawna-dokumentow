# Copy to .env and fill in. Compose reads .env from this directory
# automatically. Keep real credentials out of version control: .env is
# gitignored, this template is not.
#
# Every variable below has a default in compose.yaml except the keys, which are
# the only values you must supply. README.md documents the full set.

# Analysis model. One OpenRouter key can serve this and the embeddings below;
# they stay two variables because either endpoint can be repointed on its own.
MODEL_API_KEY=
# MODEL_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NAME=meta/muse-spark-1.3-contributor
# A JSON object of headers a provider requires beyond the OpenAI interface.
# MODEL_EXTRA_HEADERS=

# Embedding service. The corpus was built in this vector space and retrieval
# refuses a collection whose probe disagrees, so this is not a dial: repointing
# it invalidates the corpus rather than just a run.
OPENROUTER_API_KEY=
# EMBEDDINGS_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDINGS_PROVIDER=deepinfra

# Corpus and run mode.
# CORPUS_MANIFEST=/app/corpus/manifest.example.json
# CORPUS_SNAPSHOT_ID=
# EVALUATION_BATCH_OPEN=false
# LOG_LEVEL=INFO
# POSTGRES_PASSWORD=secret

# Development endpoint, used only with compose.dev.yaml. Both are required by
# that file; MODEL_EXTRA_HEADERS-style JSON applies here too, and {} declares an
# endpoint that needs no extra headers.
# MODEL_DEV_API_KEY=
# MODEL_DEV_EXTRA_HEADERS={}
# MODEL_DEV_BASE_URL=https://opencode.ai/zen/go/v1
# MODEL_DEV_NAME=muse-spark-1.3-contributor
