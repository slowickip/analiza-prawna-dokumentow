# Python bytecode and the local virtualenv
__pycache__/
*.py[cod]
.venv/

# Tool caches
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Build output
build/
dist/
*.egg-info/

# Credentials and local Compose settings. Compose reads .env from this
# directory automatically; copy .env.example to .env and fill it in.
.env
.env.*
!.env.example

# Legal corpus: the seeder fetches it from the sources the manifest names.
corpus/*
!corpus/manifest.example.json
!corpus/manifest.smoke.json

# Frontend dependencies and build output
web/node_modules/
web/dist/

# Evaluation runs outside a registered measurement
evaluation-data/results/local/

# Editors and operating system
.idea/
.vscode/
.DS_Store
